# ── 음성인식 ──────────────────────────────────────────────────────────────
# ASR_PROVIDER: mock | azure | local | ensemble
#   mock      키 없이 흐름만 시연
#   azure     Azure AI Speech. format=detailed 로 NBest 여러 개 + confidence 를 받는다
#   local     우리가 파인튜닝한 whisper (asr-poc/serve.py 를 8020 포트로 띄워야 한다)
#   ensemble  ★명세서 4.3의 2-소스 앙상블. 두 엔진을 동시에 부른다.
#             로컬 모델은 정확한 1순위를, Azure는 확정 게이트(SF-04)가 요구하는
#             후보 2~3개를 만든다. 한쪽이 실패해도 나머지로 진행한다.
ASR_PROVIDER=mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
LOCAL_ASR_URL=http://localhost:8020

# ── LLM 의도 복원 (SF-03 slow path) ───────────────────────────────────────
# LLM_PROVIDER: mock | gemini | ollama | openai_compat | anthropic
#   gemini  https://aistudio.google.com 에서 무료 키 발급 → LLM_API_KEY 에 붙여넣기
#           모델 이름은 scripts/check_keys.py 가 계정에 물어서 알려준다
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# 확인: uv run python scripts/check_keys.py
